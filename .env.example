# ═══════════════════════════════════════════════════════════════════════════
# Orb Hospital OS — Environment Configuration Example
# ═══════════════════════════════════════════════════════════════════════════
# Copy to `.env` (`cp .env.example .env`) and fill in real values before
# deploying. Every variable Orb reads is enumerated below, grouped by concern,
# with a safe placeholder and a note on when it is required.
#
# NEVER commit a real .env with production secrets. The `changeme-*` values
# here are placeholders only and MUST be replaced for any prod deployment.
#
# Source of truth: server/config.py (backend), plus playwright.config.ts and
# vite.config.ts (tests/visual). All backend vars are prefixed ORB_.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Deployment Profile ──────────────────────────────────────────────────────
# "prod" (default) enables fail-closed security guards (JWT + ingestion key must
# be set) and high-fidelity model defaults. "dev" relaxes guards, enables demo
# mode, and selects faster/lighter models.
ORB_DEPLOYMENT_PROFILE=prod

# Permits synthetic/simulated clinical CONTENT (mock notes, simulation bots).
# Defaults ON in dev, OFF in prod. Never enable against real PHI.
ORB_DEMO_MODE=false


# ─── Server / Networking ─────────────────────────────────────────────────────
# Bind address. Default 127.0.0.1 (loopback only). Set to 0.0.0.0 ONLY when LAN/
# cluster exposure is intended — note there is no built-in TLS, so terminate TLS
# at a reverse proxy when exposing beyond loopback.
ORB_HOST=127.0.0.1
# Backend listen port.
ORB_PORT=8000


# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. The http:// defaults are
# dev-only; in prod lock this to your real https:// frontend origin(s).
ORB_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ─── Host names Orb answers to ───────────────────────────────────────────────
# Orb refuses (400) a request whose Host header is a name it does not know, which
# stops a DNS-rebinding web page from reaching it through a ward browser. Any IP
# address always passes, and so do localhost, the hosts in ORB_CORS_ORIGINS and
# ORB_PUBLIC_APP_BASE_URL, this machine's own name and its .local name. List extra
# names here (comma-separated) only if staff or a device use a name in none of
# those. "*" turns the check off; the Trust Center then shows it red. The Vite
# dev server (npm run dev) answers to the same names, so list a tunnel such as
# ngrok here too.
# ORB_ALLOWED_HOSTS=


# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# REQUIRED in prod profile — startup raises if unset when ORB_DEPLOYMENT_PROFILE=prod.
# Use a long, random, secret string. Dev falls back to an insecure built-in default.
ORB_JWT_SECRET=changeme-generate-a-long-random-secret
# Signs the patient discharge-portal links. REQUIRED in prod, and must differ
# from ORB_JWT_SECRET so a leak or rotation of one does not reach the other.
# Generate with: openssl rand -hex 32
ORB_DISCHARGE_JWT_SECRET=changeme-generate-a-different-random-secret
# TEMPORARY migration escape hatch: set to 1 to let accounts still holding a
# legacy unsalted-SHA-256 password hash log in (a successful login upgrades the
# hash to bcrypt in place). Default OFF: such accounts are refused with
# "password reset required by an administrator". Startup logs a COUNT of
# remaining legacy-hash accounts; unset this the moment it reaches zero.
ORB_ALLOW_LEGACY_SHA256=0
# Session-cookie Secure flag: "auto" (default) marks the cookie Secure per
# request when the effective scheme is HTTPS; 1/0 forces it on/off.
ORB_COOKIE_SECURE=auto
# Server-side lifetime (minutes) of a PIN-on-tablet session (default 15). The
# password-session lifetime is JWT_EXPIRY_HOURS in code, not an env var.
ORB_DEVICE_PIN_SESSION_MINUTES=15


# ─── MFA (TOTP) ──────────────────────────────────────────────────────────────
# Issuer label shown in authenticator apps when a user enrolls.
ORB_MFA_ISSUER=Orb Hospital OS
# Comma-separated roles that MUST use MFA once enrolled (e.g. "admin,doctor").
# Empty = MFA optional for everyone.
ORB_MFA_REQUIRED_ROLES=


# ─── Encryption at Rest ──────────────────────────────────────────────────────
# Encrypts the SQLite database itself with SQLCipher. When this key is set AND a
# SQLCipher driver is importable (`sqlcipher3-wheels` is pinned in
# server/requirements.txt), orb.db and its -wal/-shm sidecars are opened
# encrypted. With the key set and NO driver, Orb refuses to start rather than
# open the database in plaintext, and at boot it checks that the open connection
# really is SQLCipher. Without the key the database is plaintext. Generate with:
# openssl rand -hex 32
#
# A FRESH database is created encrypted automatically. An EXISTING plaintext
# orb.db must be migrated once — SQLCipher cannot open a plaintext file and the
# app fails with "file is not a database" until you do:
#     cd server && .venv/bin/python scripts/encrypt_db.py --check     # report only
#     cd server && .venv/bin/python scripts/encrypt_db.py --migrate   # server stopped
#
# Validated 2026-07-30 on Apple Silicon / Python 3.12: SQLCipher coexists with
# sqlite-vec vector search, FTS5, and WAL mode.
#
# WHAT THIS DOES AND DOES NOT PROTECT (read before claiming at-rest coverage):
# with the key sitting in this .env on the same disk as the database, encryption
# protects COPIES of the data — backups, exports, a disk or volume image read on
# another machine. It does NOT protect a running appliance, or a stolen one whose
# .env the attacker can read just as easily as the DB. Enable FileVault (or LUKS)
# as well; sourcing this key from the OS keychain rather than a dotfile is the
# stronger posture.
#
# OPERATIONAL RISK: backups of an encrypted DB are themselves encrypted with this
# same key, so a restore is impossible without it. Escrow the key somewhere other
# than the machine it protects, or the backups are unrecoverable. Rotating this
# key also strands every existing backup.
ORB_DB_ENCRYPTION_KEY=changeme-db-encryption-key
# When set, uploaded PHI media (Lens images, Scribe audio) are encrypted at rest
# with AES-256-GCM. In the prod profile an upload with no key is REFUSED (see
# ORB_REQUIRE_UPLOAD_ENCRYPTION below); in dev it is stored in cleartext.
ORB_UPLOAD_ENCRYPTION_KEY=changeme-upload-encryption-key


# ─── Database / Storage ──────────────────────────────────────────────────────
# Override the SQLite DB file path (tests point this at a throwaway DB). Defaults
# to server/orb.db. Leave unset for normal deployments.
# ORB_DB_PATH=/absolute/path/to/orb.db


# ─── Ingestion ───────────────────────────────────────────────────────────────
# Data ingestion mode — WHERE VITALS COME FROM. Pick one deliberately:
#   "simulation" = synthetic vitals/report/lab bots drive the wards. For demo,
#                  development and evaluation boxes — no monitors or HL7 feed
#                  needed.
#   "ingestion"  = real data only (/api/ingest/* + the bedside-monitor feed);
#                  every simulation bot is disabled.
#   "hybrid"     = both simulation bots and ingestion endpoints active.
# TRAP: on a fresh box with no monitor feed wired up, "ingestion" means NO
# vitals producer exists at all — every chart sits silently frozen at its seed
# values, with no error anywhere to say why. This file therefore ships
# "simulation"; switch to "ingestion" only when a real feed is actually
# connected (the code default, absent this variable, remains "ingestion").
ORB_INGESTION_MODE=simulation
# API key protecting the real-patient write path (/api/ingest/*). REQUIRED in
# prod profile — startup raises if unset when ORB_DEPLOYMENT_PROFILE=prod.
# Compared timing-safe. Dev falls back to an insecure built-in default.
ORB_INGESTION_API_KEY=changeme-ingestion-api-key


# ─── Bedside monitor feed (HL7v2 over MLLP) ──────────────────────────────────
# OFF by default: until a site visit names the ward's monitor make/model there
# is nothing to point a listener at, and an open port with no sender is a
# liability. 1/true runs the monitor feed (services/vitals_source).
ORB_MONITOR_ENABLED=false
# Wire protocol. "hl7v2-mllp" is the only supported value today.
ORB_MONITOR_PROTOCOL=hl7v2-mllp
# "listen" = the monitor connects to Orb; "connect" = Orb dials out.
ORB_MONITOR_MODE=listen
# Bind address in listen mode / target in connect mode. 2575 = IANA HL7 MLLP port.
ORB_MONITOR_HOST=127.0.0.1
ORB_MONITOR_PORT=2575
# Provenance/source id, for a ward running more than one feed. Optional.
# ORB_MONITOR_SOURCE_ID=ward-a-monitors
# IANA zone an offset-less HL7 timestamp is read in (e.g. Asia/Kolkata) —
# monitors print local wall-clock time. Defaults to the appliance's OS zone.
# ORB_HL7_DEFAULT_TZ=Asia/Kolkata
# Per-device timezone override, for a gateway configured in a different zone.
# ORB_MONITOR_TZ=Asia/Kolkata
# Seconds a device clock may drift from ours before a visible fault is raised
# (readings are still scored — a wrong clock is an ops fault, not a mute button).
ORB_MONITOR_CLOCK_SKEW_TOLERANCE_SECONDS=900


# ─── Audit ───────────────────────────────────────────────────────────────────
# When "true", simulation-generated events are also written to the audit log.
# Default false to avoid flooding the tamper-evident chain with synthetic rows.
ORB_AUDIT_SIMULATION_EVENTS=false


# ─── Discharge / Patient Portal Access ───────────────────────────────────────
# Lifetime (days) of a discharge-summary access token.
ORB_DISCHARGE_ACCESS_TTL_DAYS=30
# Failed-attempt threshold before a discharge access code is locked.
ORB_DISCHARGE_ACCESS_MAX_ATTEMPTS=5
# Lockout duration (minutes) after too many failed attempts.
ORB_DISCHARGE_ACCESS_LOCK_MINUTES=15
# Public base URL used when generating patient-facing links (Bridge portal):
# every discharge link and QR code is this + /discharge/<token>. The value below
# is the Vite dev server and suits the dev profile only. On an appliance set it
# to the https address staff type (install runbook, section 8.4): the prod
# profile issues no discharge link while it is unset, not https, or names this
# machine (localhost, 127.0.0.1, 0.0.0.0).
ORB_PUBLIC_APP_BASE_URL=http://localhost:5173
# Discharge link on or off (default true). The link opens only on a network
# routed to the appliance, never from home (ruling of 4 October 2026). Where no
# patient Wi-Fi reaches the appliance, set false: no link or QR code is issued
# and the printed summary is the handover (install runbook, section 7, item 6).
# ORB_DISCHARGE_LINK_ENABLED=false


# ─── LLM / Ollama ────────────────────────────────────────────────────────────
# Base URL of the Ollama engine (this machine on the appliance, or a remote GPU box).
ORB_OLLAMA_BASE_URL=http://localhost:11434
# Shared MedGemma model used across Sage, Lens, Bridge, Scribe.
ORB_LLM_MODEL=medgemma:27b
# Vision model. Defaults to the same instance as ORB_LLM_MODEL (one model in VRAM).
ORB_VISION_MODEL=medgemma:27b
# How long Ollama keeps the model loaded. Accepts a duration ("1h") or integer seconds.
ORB_OLLAMA_KEEP_ALIVE=1h
# Cheap tier for bounded ambient work (Relay classification, background
# extraction). Defaults to ORB_LLM_MODEL; point at e.g. medgemma:4b to offload.
ORB_AMBIENT_LLM_MODEL=medgemma:27b
# When the primary model is not resident in Ollama, serve the turn on the
# ambient tier instead of paying a ~80 s cold load. false = always use primary.
ORB_MODEL_FALLBACK_ENABLED=true
# Micro-batching of concurrent ambient classify calls: window (ms; 0 disables)
# and max calls coalesced per GPU pass.
ORB_AMBIENT_BATCH_WINDOW_MS=150
ORB_AMBIENT_BATCH_MAX=8

# ─── Thinking mode (clinician-facing effort switch) ──────────────────────────
# Default when a request carries no flag: "on" = the careful 27B (safe default).
ORB_THINKING_DEFAULT=on
# Master switch for offering the fast lane at all. false pins every turn to the
# careful model.
ORB_FAST_MODE_ENABLED=true
# Model serving "thinking OFF" (falls back to the careful model if not pulled).
ORB_FAST_MODEL=medgemma:4b
# Safety floor: routes dosing/patient questions to the careful model even with
# thinking OFF. Do not set to 0 on a pilot ward — see services/thinking_mode.py.
ORB_FAST_MODE_SAFETY_FLOOR=1

# ─── Background LLM volume governor ──────────────────────────────────────────
# false restores ungoverned background submission (nothing coalesced or shed).
ORB_BG_LLM_GOVERNOR=true
# Ceiling on admitted background LLM calls per rolling 60 s.
ORB_BG_LLM_MAX_PER_MIN=12
# How long a background caller waits for a clinician's turn before taking its
# deterministic fallback (seconds).
ORB_BG_LLM_YIELD_WAIT_SECONDS=3.0
# Quiet tail after the last interactive turn releases (seconds).
ORB_BG_LLM_QUIET_AFTER_INTERACTIVE_SECONDS=2.0

# ─── Sage chart-open prewarm ─────────────────────────────────────────────────
# Pushes the assembled chart prefix through the model as a 1-token request when
# a chart opens, so the first real question pays for its question only.
ORB_SAGE_PREWARM=true
# Per-patient minimum interval between prewarms (seconds).
ORB_SAGE_PREWARM_MIN_INTERVAL=45
# Prewarm request timeout (seconds).
ORB_SAGE_PREWARM_TIMEOUT=90
# How long a prewarm may queue behind other GPU work before giving up (seconds).
ORB_SAGE_PREWARM_QUEUE_WAIT=25


# ─── Lens (Medical Image Analysis) ───────────────────────────────────────────
# Ships no validated imaging model — decision-support reference prose only, never
# a diagnostic device. Enabled in dev; OFF in prod unless explicitly opted in.
ORB_LENS_ENABLED=false


# ─── Clinical switches (Orb Ward Record) ─────────────────────────────────────
# false: observation sets are stored with no NEWS2 computed, shown or logged, no
# escalation, no Relay alert and no sepsis bundle; the score preview answers 404.
ORB_SCORING_ENABLED=true
# false: a high NEWS2 never opens a sepsis bundle by itself; a clinician can still
# start one by hand.
ORB_SEPSIS_AUTOSTART=true
# Minutes. A set the ward clerk copies from the paper sheet whose sheet time is
# older than this when it is keyed is charted and scored for the record but
# raises nothing live: no Relay alert, no escalation, no sepsis bundle. 0 makes
# every copied set record only.
ORB_TRANSCRIBED_LIVE_HOOK_MAX_AGE_MINUTES=120
# false: no local model runs (Sage, Scribe, Lens, Relay ambient cards, Sage
# insights, the alert assessment, the knowledge workers, speech transcription,
# boot warm-ups); their routes answer 404 "Switched off on this computer".
ORB_MODELS_ENABLED=true
# true: the Orb Ward Record profile. Forces ORB_SCORING_ENABLED,
# ORB_SEPSIS_AUTOSTART, ORB_LENS_ENABLED and ORB_MODELS_ENABLED to false whatever
# they say, switches the I-PASS handover off and shows only the Ward Record
# screens. The boot log names every setting it forced.
ORB_WARD_RECORD=false


# ─── Scribe Pipeline (ASR → Correction → Draft → Verify) ─────────────────────
# ASR (transcription) stage.
ORB_SCRIBE_ASR_MODEL=large-v3
ORB_SCRIBE_ASR_PROVIDER=whisper-mlx
ORB_SCRIBE_ASR_BATCH_SIZE=12
ORB_SCRIBE_ASR_QUANT=
# Default transcription language: "en", "hi", or "auto" (code-switching).
ORB_SCRIBE_ASR_LANGUAGE=en
# Correction stage (LLM cleanup of raw transcript).
ORB_SCRIBE_CORRECTION_ENABLED=true
ORB_SCRIBE_CORRECTION_MODEL=medgemma:27b
ORB_SCRIBE_CORRECTION_PROVIDER=ollama
ORB_SCRIBE_CORRECTION_TEMP=0.1
ORB_SCRIBE_CORRECTION_MAX_TOKENS=2048
ORB_SCRIBE_CORRECTION_CTX=8192
# Draft stage (structures note into SOAP/Discharge/Handoff).
ORB_SCRIBE_DRAFT_MODEL=medgemma:27b
ORB_SCRIBE_DRAFT_PROVIDER=ollama
ORB_SCRIBE_DRAFT_TEMP=0.3
ORB_SCRIBE_DRAFT_MAX_TOKENS=4096
ORB_SCRIBE_DRAFT_CTX=8192
# Verify stage (optional hallucination check). Disabled by default.
ORB_SCRIBE_VERIFY_ENABLED=false
ORB_SCRIBE_VERIFY_MODEL=medgemma:27b
ORB_SCRIBE_VERIFY_PROVIDER=ollama
ORB_SCRIBE_VERIFY_TEMP=0.1
ORB_SCRIBE_VERIFY_MAX_TOKENS=1024
ORB_SCRIBE_VERIFY_CTX=8192


# ─── Sage Ambient (background clinical intelligence) ─────────────────────────
ORB_SAGE_AMBIENT=true
ORB_SAGE_AMBIENT_DEBOUNCE=3
ORB_SAGE_AMBIENT_WINDOW=15
ORB_SAGE_AMBIENT_MAX_SUMMARY=1500
ORB_SAGE_AMBIENT_MAX_INTENTS=8
ORB_SAGE_AMBIENT_TIMEOUT=30
# Fraction (0.0–1.0) of eligible turns sampled for ambient analysis.
ORB_SAGE_AMBIENT_SAMPLE_RATE=1.0


# ─── Voice Intelligence Pipeline ─────────────────────────────────────────────
# Streaming Whisper daemon.
ORB_WHISPER_SOCKET=ipc:///tmp/orb-whisper.sock
ORB_WHISPER_STREAMING_MODEL=large-v3
ORB_WHISPER_TIMEOUT_MS=5000
ORB_WHISPER_DAEMON_ENABLED=true
# Voice Activity Detection (Silero VAD) thresholds.
ORB_VAD_THRESHOLD=0.5
ORB_VAD_MIN_SPEECH_MS=250
ORB_VAD_MIN_SILENCE_MS=300
# RxNorm-backed drug-name corrector.
ORB_CORRECTOR_MAX_EDIT=2
ORB_CORRECTOR_ENABLED=true
# Conversational voice agent (spoken clinical Q&A, POST /api/sage/voice).
# OFF for patient-facing deployments. This lane answers clinical questions on the
# 4B and speaks the answer with no source, no confidence and no caveat — the 4B
# was measured wrong on 8/20 drug/dose recall questions. Leave false until the
# lane runs on the 27B and streams its sources. Scribe dictation is unaffected.
ORB_VOICE_AGENT_MAX_TOKENS=256
ORB_VOICE_AGENT_TEMP=0.3
ORB_VOICE_AGENT_ENABLED=false


# ─── TLS (opt-in, in transit) ────────────────────────────────────────────────
# When both are set, Orb serves HTTPS directly. Otherwise terminate TLS at a
# reverse proxy. Leave unset if a proxy handles TLS.
# ORB_TLS_CERT=/absolute/path/to/fullchain.pem
# ORB_TLS_KEY=/absolute/path/to/privkey.pem
# Set to 1 when a proxy in front of Orb terminates TLS, so the Trust Center
# reports a declared proxy rather than plain HTTP.
# ORB_TLS_TERMINATED_UPSTREAM=1


# ═══════════════════════════════════════════════════════════════════════════
# Test / CI-only variables (playwright.config.ts, vite.config.ts, tests/visual)
# Not needed for a normal deployment — documented here for completeness.
# ═══════════════════════════════════════════════════════════════════════════
# Path to a Chromium binary for Playwright. Unset on a normal host to use
# Playwright's managed browser (`npx playwright install chromium`).
# ORB_CHROMIUM_PATH=/opt/pw-browsers/chromium
# Frontend base URL the e2e suite drives.
# ORB_E2E_BASE_URL=http://localhost:5173
# Backend URL the e2e suite expects.
# ORB_E2E_BACKEND_URL=http://localhost:8000
# Set to "1" to boot backend + vite yourself instead of letting Playwright manage them.
# ORB_E2E_NO_WEBSERVER=0
# Base URL used by the visual audit / general test tooling.
# ORB_BASE_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════════
# Operational / observability (added in the auth-hardening slice — previously
# read by code but undocumented). All optional with safe defaults.
# ═══════════════════════════════════════════════════════════════════════════
# Bearer token required to scrape GET /metrics. UNSET = the endpoint is OPEN
# (operational counts only, no PHI). Set a token in any networked deployment.
# ORB_METRICS_TOKEN=change-me-metrics-token
# Directory for on-demand DB backups (default: <repo>/backups).
# ORB_BACKUP_DIR=/var/lib/orb/backups
# Days to retain DB backups before pruning (default: 14).
# ORB_BACKUP_RETAIN_DAYS=14
# Module groups a backup MUST hold rows in, comma-separated. Read by
# scripts/lib/verify_restore.py, so it applies to backup.sh, restore-drill.sh and
# standby-restore.sh alike. Unset (the default) means empty modules are REPORTED
# and not failed — which is correct before go-live and wrong after it, and only
# the site knows which. Set it the day a module goes live:
#     ORB_BACKUP_REQUIRE_NONEMPTY=billing,payments
# Group names are the ones the drill prints (billing, payments, claims,
# procurement, front_desk, biomedical, housekeeping, abdm, workforce, dietary,
# nabh). A name that is not a group FAILS rather than being ignored, so a typo
# cannot quietly switch the check back off.
# ORB_BACKUP_REQUIRE_NONEMPTY=
# Local thresholds for the ops status page (./scripts/orb.sh status,
# /api/ops/status) and the Trust Center. Read on this appliance only; nothing
# is sent anywhere (Orb has no internet connection). The names are older than
# that rule and are kept so existing .env files keep working.
# Newest backup older than this many hours is flagged on both (default 36).
# ORB_HEARTBEAT_BACKUP_MAX_AGE_H=36
# Free disk below this percentage is flagged on the status page (default 10).
# ORB_HEARTBEAT_DISK_MIN_PCT=10
# Directory for FHIR downtime self-exports (default: <repo>/downtime_exports).
# ORB_FHIR_EXPORT_DIR=/var/lib/orb/downtime_exports
# Hospital display name shown in headers / exports (default: "Orb Hospital").
# ORB_HOSPITAL_NAME=Orb Hospital
# Upload encryption enforcement. Unset: ON in the prod profile (an upload with
# no key fails closed instead of being stored in plaintext), off in dev. 1 forces
# it on in any profile; 0 is an explicit opt-out and shows on the Trust Center.
# ORB_REQUIRE_UPLOAD_ENCRYPTION=1
# Set to 1/true to skip loading the Sage RAG knowledge base at startup
# (faster boot for demos / tests that don't exercise clinical retrieval).
# ORB_SKIP_KNOWLEDGE_BASE=0

# ═══════════════════════════════════════════════════════════════════════════
# Shadow mode — the pilot's measuring instrument (docs/SHADOW_MODE.md,
# server/services/shadow_service.py + shadow_scorecard_service.py).
# ═══════════════════════════════════════════════════════════════════════════
# READ THIS BEFORE GO-LIVE. The pilot exists to produce evidence about whether
# Orb helped, and this instrument is the only thing that produces it. Until
# 2026-08-14 none of these variables appeared in this file at all, so an
# operator building an appliance config had no way to learn the instrument had
# settings — and the defaults below are the ones the whole pilot then runs on.
# Every one of them ships safe; the point of listing them is that they become
# visible and deliberate rather than accidental.
#
# Master switch. Default on. Off makes every emit a no-op that still returns
# cleanly, so a broken instrument can be disabled in the field without a
# redeploy — at the cost of the pilot measuring nothing from that moment on.
# ORB_SHADOW_ENABLED=true
#
# How often the negatives sweeper runs, in seconds (default 300, floor 30).
# THE NEGATIVES DO NOT EXIST UNTIL THIS LOOP RUNS: nothing else in Orb writes a
# row when an alert is never opened, a proposal is never actioned, or an episode
# simply ends. Without the sweep the scorecard silently scores the successes
# only — the most flattering failure mode the instrument has. Longer intervals
# just delay those rows; they do not lose them.
# ORB_SHADOW_SWEEP_INTERVAL_S=300
#
# Which shadow phase the site is in. Default "A", the silent phase, and the
# default is deliberate: assuming a LATER phase would quietly relabel clean
# data as contaminated. Set this only when the phase actually changes, and
# prefer the schedule below so history stays correctly labelled.
# ORB_SHADOW_PHASE=A
#
# When each phase STARTED, so events are labelled by the phase they happened in
# rather than the phase the box is in today. Compact form (phase@ISO-8601, UTC):
#     ORB_SHADOW_PHASE_SCHEDULE=A@2026-08-01T00:00:00Z,C@2026-09-15T00:00:00Z
# or JSON: [{"phase":"A","start":"2026-08-01T00:00:00+00:00"}, ...]
# Unparsable values log a warning and fall back to ORB_SHADOW_PHASE — check the
# log after setting it. Unset = every event is Phase A.
# ORB_SHADOW_PHASE_SCHEDULE=
#
# Ward shifts the scorecard buckets by, as start-end pairs. Default is the
# 3 x 8h pattern below; set it to the site's ACTUAL shift boundaries or the
# per-shift numbers straddle handovers and mean very little. A pair whose end is
# before its start crosses midnight, which is how the night shift is expressed.
# ORB_SCORECARD_SHIFTS=07:00-15:00,15:00-23:00,23:00-07:00

# ═══════════════════════════════════════════════════════════════════════════
# Fresh-install access posture (server/services/bootstrap_service.py).
# ═══════════════════════════════════════════════════════════════════════════
# Every boot, on its own daemon thread, Orb answers two questions: is there a
# login-capable admin, and is any staff account still holding one of Orb's
# shipped demo passwords ("password" and friends — see the denylist in that
# module). In the PROD profile a default-credential account is DEACTIVATED, not
# merely logged; on a hospital LAN, ADM001/password is the whole threat model in
# one HTTP request. Check the posture by hand at any time:
#     server/.venv/bin/python server/scripts/access_review.py --deep
# Set to 0 to disable the check entirely. Do not do this on an appliance.
# ORB_BOOTSTRAP_CHECK_ENABLED=1
# Wall-clock seconds the bcrypt credential sweep may take (default 300 — about a
# 100-staff roster at the measured 236 ms/verify). Privileged accounts are always
# checked first, and a truncated sweep says so rather than reporting "clean".
# ORB_BOOTSTRAP_SCAN_BUDGET_S=300
# Where the bootstrap writes status.json and FIRST-ADMIN-REQUIRED.txt
# (default: <server>/ops/bootstrap).
# ORB_BOOTSTRAP_DIR=/var/lib/orb/ops/bootstrap

# ═══════════════════════════════════════════════════════════════════════════
# Warm standby (scripts/standby-restore.sh — see docs/WARM_STANDBY.md).
# ═══════════════════════════════════════════════════════════════════════════
# SET THESE ON THE SECOND MAC ONLY. The nightly job overwrites orb.db; on the
# primary that is a day of ward charting destroyed every night at 03:30. Both
# the script and its installer refuse to run where an Orb is answering.
# Where the primary's backups land (backup.sh --offsite writes them there).
# ORB_STANDBY_SOURCE_DIR=/Volumes/OrbSync
# Receipt the restore writes on every run. Nothing reads it automatically: a
# person checks it (and the job's log) in the daily on-site check. A standby
# that silently stopped restoring is a cold standby wearing a warm standby's
# clothes.
# ORB_STANDBY_RECEIPT=/var/lib/orb/ops/standby/last-restore.json
# The standby needs BOTH ORB_DB_ENCRYPTION_KEY (database) and
# ORB_UPLOAD_ENCRYPTION_KEY (Lens images, Scribe audio — a DIFFERENT key).
# Escrowing only the database key still loses every image and every dictation.

# ═══════════════════════════════════════════════════════════════════════════
# Data layer (see docs/DATA_LAYER.md).
# ═══════════════════════════════════════════════════════════════════════════
# Storage backend. 'sqlite' is the only wired backend; 'postgres' is scaffolded
# and fails fast at boot (SQL-dialect work pending — see docs/DATA_LAYER.md).
# ORB_DB_BACKEND=sqlite
# Per-thread connection pooling. ON BY DEFAULT IN THE CODE, and there is
# deliberately NO line to uncomment below, because the only thing you could
# write here is the setting that froze the appliance.
#
# This template used to say "Off by default; the per-call model is thread-safe"
# and offer a ready-to-uncomment ORB_DB_POOL=0. Both halves were wrong, and the
# second half was dangerous. What the unpooled path actually does (db_backend.py
# ~:143, and §3.3 of the WORKLOG):
#
#   Per-call connections mean a real conn.close() per query. On the SQLCipher
#   driver Orb ships (sqlcipher3-wheels), pysqlite_connection_close holds the
#   GIL across sqlite3_close_v2 — verified by disassembling the shipped binary.
#   That call checkpoints the WAL, so the whole process stops for ~1 ms per MB
#   of WAL. Under ward-level churn on a 213 MB encrypted database, two threads
#   contending the per-inode VFS mutex while one held the GIL deadlocked the
#   appliance permanently: /api/health dead, 0.2% CPU, kill -9 the only exit.
#   Captured live 2026-08-01. See F1b in docs/INSTALL_RUNBOOK.md.
#
# Safety must not depend on remembering a line in .env, so the safe path is the
# default and ORB_DB_POOL=0 is an explicit opt-out that no appliance should ever
# take. Do not add it here to "restore the documented default" — this comment is
# the documented default.
#
# NOTE the blind spot: the test suite runs PLAINTEXT stdlib sqlite3, whose close
# DOES release the GIL, so it can never reproduce the above. Green tests are not
# evidence about this failure mode.
