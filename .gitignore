*.pdf

# ---- Test / scratch artifacts ----
*.webm
tmp/

# Side projects that keep their own git history
sites/

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/
*.log

# local agent config (machine-specific launch.json)
.claude/

# Playwright transient run artifacts
playwright-report/
test-results/

# Runtime PHI export dir (FHIR downtime self-export)
server/downtime_exports/

# Loop-watchdog incident evidence (thread dumps + status.json). Per-appliance
# runtime state, and a stall dump names live thread/file paths — keep it local.
server/ops/

# Visual-audit harness output (screenshots, findings, gallery + CI mirrors)
tests/visual/out/
tests/visual/out-live/
tests/visual/offline-2026-10/
tests/visual/shots/
tests/visual/audit-results.json
tests/visual/orb-gallery.html
tests/visual/*.log
.vite-dev.log
.backend.log

# server/eval/retrieval_thresholds.json is SHIPPED, not ignored (rule dropped
# 2026-10-04). Since 2026-08-15 one file carries both scorers' floors
# (min_relevance_cross_encoder and min_relevance_lexical) with provenance, and
# the runtime picks the floor for whichever scorer it has, so one committed
# file serves dense and lexical appliances alike. Without it every clean
# checkout fell back to the hand-picked defaults the calibration exists to
# replace, and tests/test_evidence_relevance.py failed. Re-run
# scripts/calibrate_retrieval.py after changing the corpus or the models and
# commit the result.

# ---- Added 3 October 2026 when the tree went back under git ----
# Backup folders and snapshots. docs/archive holds dated pre-change copies of
# source files, kept on disk as evidence; tracking them would put stale code
# copies in every search. Git history replaces them from here on.
backups/
stale-backups/
_to_delete/
docs/archive/
*.bak
*.tar
*.tar.gz
*.tgz
*.zip

# Evaluation output derived from credentialed datasets (PhysioNet DUA: never
# committed, never shared). Keep the harness source, drop its output.
server/eval/vigil_retro/out/
*.npz
*.parquet

