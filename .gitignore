# ---- Node / frontend ----
node_modules/
dist/
dev-dist/
*.local
.vite/

# ---- Python / backend ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-dev/
venv/
.env
server/.env

# ---- Models & large weights (downloaded / retrained, never committed) ----
# NOTE: server/models/ is ALSO a Python source package (vigil_cfc.py, forecast_lstm.py,
# user.py, message.py). Ignore downloaded weight subdirs, but KEEP the .py source.
# (git does not support inline trailing comments in .gitignore — keep them on own lines)
/models/
# downloaded HF/weight subdirectories under server/models/
server/models/*/
# but keep the neural-net + schema source files
!server/models/*.py
!server/models/__init__.py
*.safetensors
*.gguf
*.pt
*.onnx
*.bin

# Vendored external repo (has its own git history; keep out of ours)
server/scripts/mlx-examples/
server/scripts/.cache/

# ---- Databases & runtime data (may contain PHI) ----
*.db
*.db-wal
*.db-shm
orb.db
uploads/
server/uploads/
training_data/
server/datasets/

# ---- Large generated docs / binaries ----
*.pdf
# ...but keep the founder-authored fundraising revenue model tracked.
!docs/fundraising/Orb_Revenue_Model.pdf

# ---- Test / scratch artifacts ----
*.webm

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/
*.log

# local agent config (machine-specific launch.json)
.claude/

# rendered deck previews (regenerate from the .pptx)
docs/fundraising/deck_preview/

# Playwright transient run artifacts
playwright-report/
test-results/

# Runtime PHI export dir (FHIR downtime self-export)
server/downtime_exports/

# Loop-watchdog incident evidence (thread dumps + status.json). Per-appliance
# runtime state, and a stall dump names live thread/file paths — keep it local.
server/ops/

# Visual-audit harness output (screenshots, findings, gallery + CI mirrors)
tests/visual/out/
tests/visual/out-live/
tests/visual/shots/
tests/visual/audit-results.json
tests/visual/orb-gallery.html
tests/visual/*.log
.vite-dev.log
.backend.log

# RAG confidence thresholds are calibrated PER-DEPLOYMENT (env-specific: dense vs
# lexical retrieval path). Generated by scripts/calibrate_retrieval.py; the
# runtime falls back to documented defaults when absent.
server/eval/retrieval_thresholds.json

# ---- Added 3 October 2026 when the tree went back under git ----
# Backup folders and snapshots. docs/archive holds dated pre-change copies of
# source files, kept on disk as evidence; tracking them would put stale code
# copies in every search. Git history replaces them from here on.
backups/
stale-backups/
_to_delete/
docs/archive/
*.bak
*.tar
*.tar.gz
*.tgz
*.zip

# Evaluation output derived from credentialed datasets (PhysioNet DUA: never
# committed, never shared). Keep the harness source, drop its output.
server/eval/vigil_retro/out/
*.npz
*.parquet

# Test caches
.pytest_cache/
server/.pytest_cache/

# Keys and certificates
*.pem
*.key
*.p12
*.crt
.env.*
!.env.example

# Vendored evaluation repo with its own git history
server/eval/vigil_retro/vendor/
