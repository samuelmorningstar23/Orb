# Capacity additions to an EXISTING secured Orb deployment. This is not a
# complete production .env; supply the site's auth/encryption/TLS configuration.
ORB_HTTP_MAX_INFLIGHT=200
# Full-RAG width comparison favoured 4 over the chart-only winner, 1.
# Neither met latency targets. Retest the complete workload on deployment hardware.
ORB_SAGE_RETRIEVAL_WORKERS=4
ORB_SAGE_QUEUE_WAIT_SECONDS=2
ORB_SUMMARY_ENABLED=1
ORB_SUMMARY_REFRESH_SECONDS=1800
ORB_SUMMARY_WORKERS=1
ORB_SUMMARY_MAX_PENDING=256
ORB_SUMMARY_SCAN_SECONDS=5
ORB_SUMMARY_GENERATION_TIMEOUT_SECONDS=120
ORB_SUMMARY_MODEL=medgemma:27b
# Set to the exact installed artifact digest/release before qualification.
ORB_SUMMARY_MODEL_REVISION=
ORB_SUMMARY_CONTEXT_TOKENS=16384
ORB_SUMMARY_MAX_SOURCE_CHARS=12000
# ORB_MODELS_ENABLED and ORB_BACKGROUND_MODELS_ENABLED must also permit jobs.
# Keep ORB_LLM_WORKERS unset until each local daemon has an actual load report.
# Shape and reserved background capacity: docs/LOCAL_INFERENCE_WORKERS.md.
# If a mini is the TLS gateway, set ORB_FORWARDED_ALLOW_IPS to its exact IP;
# never use '*'. Keep the SQLite database and all model origins on the Studio.
