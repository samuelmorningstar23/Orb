--- a/scripts/serve-ollama.sh
+++ b/scripts/serve-ollama.sh
@@ -12,10 +12,15 @@
 Usage: scripts/serve-ollama.sh
 
 Executes `ollama serve` on loopback, with cloud features disabled, startup
-pruning disabled, one request per model, and f16 KV cache. No model is pulled.
+pruning disabled, and f16 KV cache. The qualified full-SWA profile provides two
+live cache slots, each with Orb's 8192-token context; Orb retains one inference
+request owner. Other profiles keep one slot. No model is pulled.
 ORB_OLLAMA_SWA_FULL=auto|on|off (default auto): full SWA cache is qualified only
 for Ollama 0.35.1 on Apple Silicon with at least 64 GiB unified memory. The
 qualification covers Orb's 8192-token interactive context and cached 27B model.
+Two slots require separate KV buffers: explicit unified KV is rejected when
+full SWA is enabled. Full-size f16 KV for both slots is 7936 MiB, plus weights,
+scratch buffers, and RAM prompt snapshots.
 Explicit LLAMA_ARG_SWA_FULL is respected or a conflicting setting is rejected.
 Off means this launcher does not enable full SWA; llama.cpp config.ini can
 independently enable it. An already-running daemon must be configured separately.
@@ -88,10 +93,20 @@
   enable_full=1
 fi
 if [ "$enable_full" -eq 1 ]; then
+  # Unified KV clears idle slots after saving RAM snapshots. Separate buffers
+  # keep the general/patient prefix live while a department prompt uses slot 2.
+  if [ "${LLAMA_ARG_KV_UNIFIED+x}" = x ]; then
+    case "$LLAMA_ARG_KV_UNIFIED" in
+      0|false|off|disabled) ;;
+      1|true|on|enabled) fail 'Full SWA cache slots require LLAMA_ARG_KV_UNIFIED=false; explicit unified KV conflicts.' ;;
+      *) fail 'For full SWA cache slots, LLAMA_ARG_KV_UNIFIED must be 0/false/off/disabled.' ;;
+    esac
+  fi
+  export OLLAMA_NUM_PARALLEL=2 LLAMA_ARG_KV_UNIFIED=false
   if [ "$explicit" = unset ]; then export LLAMA_ARG_SWA_FULL=1; fi
   info 'Full SWA cache enabled for the qualified 64 GiB Apple Silicon profile (Ollama 0.35.1).'
 else
   info 'Full SWA is not enabled by this launcher; runner config.ini may independently enable it.'
 fi
-info "Executing Ollama $version on $OLLAMA_HOST; parallel=1, KV=f16, cloud disabled."
+info "Executing Ollama $version on $OLLAMA_HOST; cache slots=$OLLAMA_NUM_PARALLEL, Orb inference owner=1, per-slot context=8192, KV=f16, cloud disabled."
 exec "$ollama_bin" serve
