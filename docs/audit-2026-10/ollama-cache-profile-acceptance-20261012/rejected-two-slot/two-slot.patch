+@pytest.mark.parametrize("profile", ["auto", "on"])
+@pytest.mark.parametrize("explicit", [None, "0", "false", "off", "disabled"])
+def test_qualified_full_profile_keeps_two_separate_live_cache_slots(launcher, profile, explicit):
+    overrides = {"ORB_OLLAMA_SWA_FULL": profile, "OLLAMA_NUM_PARALLEL": "99"}
+    if explicit is not None:
+        overrides["LLAMA_ARG_KV_UNIFIED"] = explicit
+    result, payload, calls = launcher(overrides)
+    assert result.returncode == 0, result.stderr
+    assert payload["env"]["OLLAMA_NUM_PARALLEL"] == "2"
+    assert payload["env"]["LLAMA_ARG_KV_UNIFIED"] == "false"
+    assert "cache slots=2, Orb inference owner=1, per-slot context=8192" in result.stderr
+    assert calls == [["--version"], ["serve"]]
+
+
+@pytest.mark.parametrize("explicit", ["1", "true", "on", "enabled", "", "surprise", "FALSE", "2"])
+def test_full_profile_rejects_conflicting_or_malformed_unified_kv_before_serve(launcher, explicit):
+    result, payload, calls = launcher({"LLAMA_ARG_KV_UNIFIED": explicit})
+    assert result.returncode == 1
+    assert "LLAMA_ARG_KV_UNIFIED" in result.stderr
+    assert payload is None
+    assert calls == [["--version"]]
+
+
+@pytest.mark.parametrize("overrides", [
+    {"ORB_OLLAMA_SWA_FULL": "off"},
+    {"LLAMA_ARG_SWA_FULL": "false"},
+    {"FAKE_OS": "Linux"},
+    {"FAKE_MEMORY": str(32 * 2**30)},
+    {"FAKE_VERSION": "ollama version is 0.36.0"},
+])
+@pytest.mark.parametrize("unified", [None, "false", "1"])
+def test_single_slot_fallback_preserves_independent_kv_setting(launcher, overrides, unified):
+    values = {**overrides, "OLLAMA_NUM_PARALLEL": "99"}
+    if unified is not None:
+        values["LLAMA_ARG_KV_UNIFIED"] = unified
+    result, payload, calls = launcher(values)
+    assert result.returncode == 0, result.stderr
+    assert payload["env"]["OLLAMA_NUM_PARALLEL"] == "1"
+    assert payload["env"]["LLAMA_ARG_KV_UNIFIED"] == unified
+    assert "cache slots=1" in result.stderr
+    assert calls == [["--version"], ["serve"]]
+
+
+def test_help_explains_live_slots_and_preserves_app_single_owner_without_commands(launcher):
+    result, payload, calls = launcher(arguments=("--help",))
+    assert result.returncode == 0
+    assert "two\nlive cache slots" in result.stdout
+    assert "8192-token context" in result.stdout
+    assert "one inference\nrequest owner" in result.stdout
+    assert "7936 MiB" in result.stdout
+    assert payload is None
+    assert calls == []
